rules_version = '2';

// 모든 클라이언트는 익명 로그인을 하고, 권한은 Cloud Function(authApi)이 커스텀 클레임으로 준다.
//   관리자  → { adminId, deviceId, code }
//   슈퍼관리자 → { superAdmin: true }
// 클라이언트는 스스로 클레임을 만들 수 없으므로, 아래 판정은 우회할 수 없다.
// Cloud Functions는 Admin SDK라 이 규칙을 우회한다 (로그인·푸시 처리에 필요).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // 클레임이 없는 토큰에서 키를 바로 꺼내면 평가 오류가 나므로 존재 여부를 먼저 본다
    function isSuper()  { return signedIn() && ('superAdmin' in request.auth.token) && request.auth.token.superAdmin == true; }
    function myAdmin()  { return signedIn() && ('adminId' in request.auth.token) ? request.auth.token.adminId : ''; }
    function myCode()   { return signedIn() && ('code' in request.auth.token) ? request.auth.token.code : ''; }

    // ===== 서버 전용 =====
    match /api_keys/{doc}      { allow read, write: if false; }
    match /viewer_tokens/{doc} { allow read, write: if false; }
    match /router_latest/{doc} { allow read, write: if false; }

    // ===== 푸시 토큰 — 본인 adminId로만 등록, 읽기는 불가 =====
    match /fcm_tokens/{doc} {
      allow read, delete: if false;
      allow create, update: if signedIn()
                            && request.resource.data.keys().hasOnly(['token', 'adminId', 'platform', 'updatedAt'])
                            && request.resource.data.adminId == myAdmin()
                            && request.resource.data.token is string
                            && request.resource.data.token.size() < 1000;
    }

    // ===== 계산 내역 — 관객이 쓰고, 담당 관리자만 읽는다 =====
    match /calculations/{doc} {
      allow read: if isSuper() || (signedIn() && resource.data.adminId == myAdmin());
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['calcId', 'adminId', 'expression', 'result', 'isForce', 'timestamp'])
                    && request.resource.data.expression is string
                    && request.resource.data.expression.size() < 200;
      allow update, delete: if false;
    }

    // ===== 설정 — 관객은 읽기만, 쓰기는 본인 관리자만 =====
    match /configs/{adminId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isSuper() || myAdmin() == adminId;
      allow delete: if false;
    }

    // ===== 실시간 입력 — 관객이 누르는 값을 담당 관리자 화면에 흘려보낸다 =====
    // 문서 하나만 계속 덮어쓰며, 남의 것을 훑어볼 수 없도록 목록 조회는 막는다.
    match /live_input/{adminId} {
      allow get: if signedIn();
      allow list, delete: if false;
      allow create, update: if signedIn()
                            && request.resource.data.keys().hasOnly(['text', 'at'])
                            && request.resource.data.text is string
                            && request.resource.data.text.size() < 200;
    }

    // ===== 관리자 코드 — 목록·수정은 슈퍼관리자만 =====
    // 관리자는 자기 코드 문서 하나만 읽는다 (정지·기기 교체 감시용).
    // 로그인 시 쓰기는 authApi가 Admin SDK로 처리한다.
    match /admin_codes/{code} {
      allow get: if isSuper() || myCode() == code;
      allow list: if isSuper();
      allow write: if isSuper();
    }

    // ===== 세션 — 전부 서버가 관리 =====
    match /admin_sessions/{doc} {
      allow read, write: if isSuper();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
