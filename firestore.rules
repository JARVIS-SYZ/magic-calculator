rules_version = '2';

// 이 앱에는 아직 Firebase 인증이 없어서 규칙이 "누가 요청했는지"를 알 수 없다.
// 그래서 지금 단계에서는 (1) 클라이언트가 애초에 만질 일 없는 컬렉션을 완전히 닫고,
// (2) 만지는 컬렉션은 허용 동작과 필드 모양을 최소로 좁히는 데까지만 한다.
// admin_codes / admin_sessions의 진짜 잠금은 익명 인증 + 커스텀 클레임 도입 후에 가능하다.
// Cloud Functions는 Admin SDK라 아래 규칙을 우회하므로 서버 동작에는 영향이 없다.

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 서버 전용 — 클라이언트 접근 전면 차단 =====
    // API 키와 뷰어 토큰이 그동안 누구에게나 읽혔다.
    match /api_keys/{doc}      { allow read, write: if false; }
    match /viewer_tokens/{doc} { allow read, write: if false; }
    match /router_latest/{doc} { allow read, write: if false; }

    // ===== 푸시 토큰 — 관리자 기기가 등록만 한다 =====
    // 읽기를 막아 토큰 수집을 차단한다. 실패 토큰 삭제는 함수가 한다.
    match /fcm_tokens/{doc} {
      allow read, delete: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['token', 'adminId', 'platform', 'updatedAt'])
                            && request.resource.data.token is string
                            && request.resource.data.token.size() < 1000;
    }

    // ===== 계산 내역 — 관객 앱이 추가만 한다 =====
    // 수정·삭제를 막아 기록을 지우지 못하게 한다.
    match /calculations/{doc} {
      allow read: if true;   // TODO(2단계): 인증 도입 후 본인 adminId 문서만
      allow create: if request.resource.data.keys().hasOnly(['calcId', 'adminId', 'expression', 'result', 'isForce', 'timestamp'])
                    && request.resource.data.expression is string
                    && request.resource.data.expression.size() < 200;
      allow update, delete: if false;
    }

    // ===== 설정 — 관객 앱이 읽고 관리자 앱이 쓴다 =====
    match /configs/{adminId} {
      allow get: if true;
      allow list: if false;              // 전체 관리자 설정 나열 차단
      allow create, update: if true;     // TODO(2단계): 본인 adminId만
      allow delete: if false;
    }

    // ===== 아직 못 잠그는 부분 =====
    // 슈퍼관리자가 코드 전체를 나열하고, 관리자 앱이 코드로 로그인한다.
    // 둘 다 클라이언트라 인증 없이는 구분이 불가능하다.
    match /admin_codes/{code}   { allow read, write: if true; }
    match /admin_sessions/{doc} { allow read, write: if true; }

    // 그 외 새 컬렉션은 기본 차단
    match /{document=**} { allow read, write: if false; }
  }
}
